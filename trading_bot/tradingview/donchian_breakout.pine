//@version=5
strategy("olliE Donchian Breakout", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1)

entryLen = input.int(20, "Entry channel", minval=2)
exitLen  = input.int(10, "Exit channel", minval=2)
atrLen   = input.int(20, "ATR length", minval=1)
atrMult  = input.float(2.0, "ATR stop mult", minval=0.5, step=0.1)
useWebhook = input.bool(true, "Send webhook JSON")

entryHigh = ta.highest(high, entryLen)[1]
exitLow   = ta.lowest(low, exitLen)[1]
atr       = ta.atr(atrLen)
plot(entryHigh, "Entry high", color=color.new(color.green, 40))
plot(exitLow, "Exit low", color=color.new(color.red, 40))

longCond = close > entryHigh
exitCond = close < exitLow
if longCond and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", from_entry="Long", stop=close - atrMult * atr)
if exitCond and strategy.position_size > 0
    strategy.close("Long")

if longCond and strategy.position_size == 0 and useWebhook
    alert('{"action":"buy","ticker":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"strategy":"Donchian","stop":' + str.tostring(close - atrMult * atr) + ',"time":"' + str.tostring(timenow) + '"}', alert.freq_once_per_bar_close)
if (exitCond and strategy.position_size > 0) and useWebhook
    alert('{"action":"sell","ticker":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"strategy":"Donchian","time":"' + str.tostring(timenow) + '"}', alert.freq_once_per_bar_close)
alertcondition(longCond, "Donchian Long", '{"action":"buy","ticker":"{{ticker}}","price":{{close}},"strategy":"Donchian"}')
alertcondition(exitCond, "Donchian Flat", '{"action":"sell","ticker":"{{ticker}}","price":{{close}},"strategy":"Donchian"}')
